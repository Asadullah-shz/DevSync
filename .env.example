PORT=3000
NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/devsync?replicaSet=rs0
JWT_SECRET=change_me_to_a_secure_random_string
REFRESH_SECRET=change_me_to_a_secure_random_string

STORAGE_ENCRYPTION_KEY=

# Server Clustering / Distributed Synchronization
# Set to enable distributed WebSocket pub/sub and distributed rate-limiting
REDIS_URL=

# SSO Configuration
# Provide credentials to enable Enterprise Authentication
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:3000/api/v1/auth

# Disk Space Protection
# Warn in server logs when disk usage exceeds DISK_WARN_PERCENT (default 80%)
# Reject uploads when disk usage exceeds DISK_BLOCK_PERCENT (default 90%)
DISK_WARN_PERCENT=80
DISK_BLOCK_PERCENT=90

# Storage Backend (local | s3)
STORAGE_BACKEND=local


S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=devsync-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

REDIS_URL=

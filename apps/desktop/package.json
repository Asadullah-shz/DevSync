{
  "name": "@devsync/desktop",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "npx concurrently \"vite\" \"wait-on tcp:5180 && electron . --dev\"",
    "build": "vite build",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "socket.io-client": "^4.8.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.1.0",
    "concurrently": "^10.0.4",
    "electron": "27.3.11",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.devsync.desktop",
    "productName": "DevSync",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asar": true
  }
}

# Database Config
# For local containerized DB, use the preconfigured docker-compose service hostname:
# DATABASE_URL=mongodb://mongodb:27017/devsync?replicaSet=rs0
DATABASE_URL=mongodb://mongodb:27017/devsync?replicaSet=rs0

# Server Config
PORT=3000
NODE_ENV=production

# Secrets
JWT_SECRET=generate_your_own_secure_jwt_secret_here
REFRESH_SECRET=generate_your_own_secure_refresh_secret_here

# Cloudflare Tunnel Configuration
# Generate a tunnel in your Cloudflare Zero Trust panel, point it to http://nginx:80, and paste the token here:
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# At-Rest Encryption (AES-256-GCM)
# Set to a 64-char hex string (32 bytes). Leave blank to disable encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=
